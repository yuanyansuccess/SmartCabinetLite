#!/bin/bash
# ============================================================================
# deploy_kylin.sh - 麒麟系统部署脚本 (由CMake configure_file生成)
# 作者: 袁燕  创建: 2026-06-20
# 用法: sudo ./deploy_kylin.sh
# ============================================================================

set -e

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}QtSmartCabinet 麒麟系统部署脚本${NC}"
echo -e "${GREEN}========================================${NC}"

# 检查root权限
if [ "$EUID" -ne 0 ]; then 
    echo -e "${RED}请使用 sudo 运行此脚本${NC}"
    exit 1
fi

# 检测架构
ARCH=$(uname -m)
echo -e "${YELLOW}系统架构: ${ARCH}${NC}"

# 创建安装目录
INSTALL_DIR="/opt/QtSmartCabinet"
echo -e "${YELLOW}创建安装目录: ${INSTALL_DIR}${NC}"
mkdir -p "$INSTALL_DIR"

# 复制可执行文件
if [ -f "QtSmartCabinet" ]; then
    cp QtSmartCabinet "$INSTALL_DIR/"
    chmod +x "$INSTALL_DIR/QtSmartCabinet"
    echo -e "${GREEN}✓ 可执行文件已安装${NC}"
else
    echo -e "${RED}错误: 未找到 QtSmartCabinet 可执行文件${NC}"
    exit 1
fi

# 复制资源文件
if [ -d "../resources" ]; then
    cp -r ../resources "$INSTALL_DIR/"
    echo -e "${GREEN}✓ 资源文件已安装${NC}"
fi

# 创建桌面快捷方式
echo -e "${YELLOW}创建桌面快捷方式...${NC}"
cat > /usr/share/applications/QtSmartCabinet.desktop << EOF
[Desktop Entry]
Name=智能工具柜管理系统
Name[zh_CN]=智能工具柜管理系统
Comment=QtSmartCabinet Smart Cabinet Management System
Comment[zh_CN]=智能工具柜管理系统
Exec=$INSTALL_DIR/QtSmartCabinet
Icon=$INSTALL_DIR/resources/icons/app_icon.png
Terminal=false
Type=Application
Categories=Utility;Office;
StartupNotify=true
EOF

chmod +x /usr/share/applications/QtSmartCabinet.desktop
echo -e "${GREEN}✓ 桌面快捷方式已创建${NC}"

# 检查依赖
echo -e "${YELLOW}检查系统依赖...${NC}"
MISSING_DEPS=""
for pkg in libqt6core6 libqt6widgets6 libqt6sql6 libqt6network6 libqt6multimedia6; do
    if ! dpkg -l | grep -q "^ii.*$pkg"; then
        MISSING_DEPS="$MISSING_DEPS $pkg"
    fi
done

if [ -n "$MISSING_DEPS" ]; then
    echo -e "${RED}缺少依赖:${MISSING_DEPS}${NC}"
    echo -e "${YELLOW}尝试自动安装...${NC}"
    apt-get update && apt-get install -y $MISSING_DEPS || {
        echo -e "${RED}自动安装失败，请手动安装依赖${NC}"
        echo -e "${YELLOW}sudo apt-get install -y $MISSING_DEPS${NC}"
    }
else
    echo -e "${GREEN}✓ 所有依赖已满足${NC}"
fi

# 配置MySQL连接 (可选)
echo -e "${YELLOW}是否配置MySQL数据库连接? (y/n)${NC}"
read -r response
if [ "$response" = "y" ] || [ "$response" = "Y" ]; then
    echo -e "${YELLOW}请输入MySQL服务器地址 [默认: localhost]:${NC}"
    read -r MYSQL_HOST
    MYSQL_HOST=${MYSQL_HOST:-localhost}
    
    echo -e "${YELLOW}请输入MySQL端口 [默认: 3306]:${NC}"
    read -r MYSQL_PORT
    MYSQL_PORT=${MYSQL_PORT:-3306}
    
    echo -e "${YELLOW}请输入数据库名 [默认: smartcabinet]:${NC}"
    read -r MYSQL_DB
    MYSQL_DB=${MYSQL_DB:-smartcabinet}
    
    echo -e "${YELLOW}请输入用户名 [默认: root]:${NC}"
    read -r MYSQL_USER
    MYSQL_USER=${MYSQL_USER:-root}
    
    echo -e "${YELLOW}请输入密码:${NC}"
    read -rs MYSQL_PASS
    
    # 创建配置文件
    cat > "$INSTALL_DIR/config.ini" << EOF
[Database]
Host=$MYSQL_HOST
Port=$MYSQL_PORT
Database=$MYSQL_DB
User=$MYSQL_USER
Password=$MYSQL_PASS
EOF
    
    echo -e "${GREEN}✓ 数据库配置已保存到 $INSTALL_DIR/config.ini${NC}"
fi

echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}部署完成!${NC}"
echo -e "${GREEN}可以在应用程序菜单中找到 '智能工具柜管理系统'${NC}"
echo -e "${GREEN}或直接运行: $INSTALL_DIR/QtSmartCabinet${NC}"
echo -e "${GREEN}========================================${NC}"
